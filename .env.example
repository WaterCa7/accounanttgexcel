# Образец. Рабочий файл называется .env и лежит рядом.

# Токен бота от @BotFather
TELEGRAM_BOT_TOKEN=

# Ключ Claude API
ANTHROPIC_API_KEY=

# Кому бот отвечает: числовые Telegram ID и/или @имена через запятую
ALLOWED_USERS=

# Ссылка на Google Таблицу, с которой работает бот
GOOGLE_SHEET_URL=

# Ключ служебного аккаунта Google: либо файл google-credentials.json рядом с main.py,
# либо весь текст этого файла в переменной GOOGLE_CREDENTIALS_JSON (удобно в панели хостинга)
GOOGLE_CREDENTIALS_FILE=google-credentials.json

# Модель и уровень усилия (low, medium, high). claude-sonnet-5-5 вдвое дешевле.
CLAUDE_MODEL=claude-opus-5-5
CLAUDE_EFFORT=medium
